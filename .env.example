# Sanctuary • AuDHD Personal Assistant & Executive Coach (.env configuration)

# Dual AI Brain (Google Gemini + Anthropic Claude)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest

# Multi-Account Google OAuth2 (Gmail & Google Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8765/api/auth/google/callback

# Multi-Account Microsoft 365 / Outlook Graph OAuth2
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:8765/api/auth/microsoft/callback

# 24/7 Cloud Scheduler Settings
BRIEFING_TIME_LOCAL=07:30
TIMEZONE=Europe/London
PORT=8765
